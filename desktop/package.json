  "react-dom": "19.2.0"
 },
 "devDependencies": {
  "@tauri-apps/cli": "2.12.1",
  "@types/react": "19.2.2",
  "@types/react-dom": "19.2.2",
  "typescript": "5.9.3",
  "vite": "7.3.7"
 }
}
